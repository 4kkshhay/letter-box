# Copy to .env and adjust. Never commit .env.

# development | production
APP_ENV=development

# Origin used to build QR URLs. Production must be the stable HTTPS origin.
PUBLIC_BASE_URL=http://localhost:8610

# Local development only: host ports, bound to 127.0.0.1.
PUBLIC_PORT=8610
ADMIN_PORT=8611

# Server only: Cloudflare Tunnel token for this project's cloudflared service.
TUNNEL_TOKEN=

# Admin login. Use long random values.
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me

# SQLite file inside the container; /data is mounted from ./data.
DATABASE_PATH=/data/letterbox.db
