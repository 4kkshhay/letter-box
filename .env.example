# Copy to .env and adjust. Never commit .env.

# Compose files to load. Local development adds loopback ports.
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

# development | production
APP_ENV=development

# Deployment overrides this with the immutable GHCR image digest. Local builds
# use letterbox:latest.
APP_IMAGE=letterbox:latest

# Origin used to build QR URLs. Production: https://letterbox.ink
PUBLIC_BASE_URL=http://localhost:8610

# Local development only: host ports. The admin port is always bound to
# 127.0.0.1; set PUBLIC_BIND=0.0.0.0 to open pages from a phone on the same
# network.
PUBLIC_BIND=127.0.0.1
PUBLIC_PORT=8610
ADMIN_PORT=8611

# Host directory holding the SQLite file, and the user that owns it
# (`id -u` / `id -g`).
DATA_DIR=./data
APP_UID=1000
APP_GID=1000

# Admin login. Generate the password hash with scripts/hash-admin-password.sh;
# never put the plain password in this file. Replace both example values.
# Example hash is for `change-me`, for first-run development only.
ADMIN_PASSWORD_HASH='scrypt$16384$8$1$bGV0dGVyYm94LWRlbW8hIQ$ZgzIcIcXBujPjraKnmTBSkb-QcWxmokK1oTsGDVgs-4'
SESSION_SECRET=change-me

# Timezone for dates and times shown in the admin dashboard.
ADMIN_TIMEZONE=Pacific/Auckland

# Server only: Cloudflare Tunnel token for this project's cloudflared service.
TUNNEL_TOKEN=
