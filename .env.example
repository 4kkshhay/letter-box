# Copy to .env and adjust. Never commit .env.

# Compose files to load. Local development adds loopback ports.
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

# development | production
APP_ENV=development

# Origin used to build QR URLs. Production must be the stable HTTPS origin.
PUBLIC_BASE_URL=http://localhost:8610

# Local development only: host ports. The admin port is always bound to
# 127.0.0.1; set PUBLIC_BIND=0.0.0.0 to open pages from a phone on the same
# network.
PUBLIC_BIND=127.0.0.1
PUBLIC_PORT=8610
ADMIN_PORT=8611

# Host directory holding the SQLite file, and the user that owns it
# (`id -u` / `id -g`).
DATA_DIR=./data
APP_UID=1000
APP_GID=1000

# Admin login. Use long random values.
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me

# Server only: Cloudflare Tunnel token for this project's cloudflared service.
TUNNEL_TOKEN=
